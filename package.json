{
  "name": "tirwin-email-list-validator",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script Email List & User Mailbox Validator Web App for @tirwin.in",
  "scripts": {
    "login": "npx @google/clasp login",
    "push": "npx @google/clasp push --force",
    "deploy": "bash ./deploy.sh",
    "open": "npx @google/clasp open",
    "logs": "npx @google/clasp logs"
  },
  "devDependencies": {
    "@google/clasp": "^2.5.0"
  }
}
